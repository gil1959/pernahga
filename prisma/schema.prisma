// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?   @unique
  phoneVerified DateTime?
  company       String?
  registrationIp String?
  isBanned      Boolean   @default(false)
  bannedReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ===== Workspace virtual (LOCKED v1.0 2026-05-23) =====
  // Fields read by Pega Engine (Pega 2) to build per-user system prompts.
  businessName    String?
  businessDesc    String?  @db.Text
  businessIndustry String?
  personaStyle    PersonaStyle  @default(SANTAI)
  personaTone     String?  @db.Text   // custom tone bicara override
  personaSignature String? // sign-off text (e.g. "Salam, Mira")
  operatingHours  String?  @db.Text  // JSON: { mon: "09-17", ... }
  faqEntries      String?  @db.Text  // JSON array [{ q, a }, ...]
  onboardingDone  Boolean  @default(false)

  accounts      Account[]
  sessions      Session[]
  consultations Consultation[]
  savedItems    SavedItem[]
  testimonials  Testimonial[]
  subscription  Subscription?
  capabilities  UserCapability[]
  usageLogs     UsageLog[]
  connections   ConnectionRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Package {
  id          String   @id @default(cuid())
  title       String
  titleEn     String
  description String   @db.Text
  descriptionEn String @db.Text
  price       String
  priceNote   String?
  priceNoteEn String?
  features    String   @db.Text // JSON array
  featuresEn  String   @db.Text // JSON array
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  // Plan capabilities (JSON array of CapabilityChannel) — auto-grant when assigned
  defaultCapabilities String? @db.Text
  monthlyCredits      Int     @default(0)
  creditsRefreshDays  Int     @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Showcase {
  id              String   @id @default(cuid())
  title           String
  titleEn         String
  slug            String   @unique
  description     String   @db.Text
  descriptionEn   String   @db.Text
  longDescription String   @db.Text
  longDescriptionEn String @db.Text
  thumbnail       String
  images          String   @db.Text // JSON array
  tags            String   @db.Text // JSON array
  techStack       String   @db.Text // JSON array
  demoUrl         String?
  caseStudy       String?  @db.Text
  caseStudyEn     String?  @db.Text
  isPublished     Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedItems SavedItem[]
}

model Education {
  id           String        @id @default(cuid())
  title        String
  titleEn      String
  description  String?       @db.Text
  descriptionEn String?      @db.Text
  type         EducationType @default(YOUTUBE)
  embedUrl     String
  thumbnailUrl String?
  category     String?
  categoryEn   String?
  isPublished  Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  company     String?
  role        String?
  avatar      String?
  content     String   @db.Text
  contentEn   String?  @db.Text
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Consultation {
  id         String             @id @default(cuid())
  userId     String
  name       String
  email      String
  company    String?
  topic      String
  message    String             @db.Text
  status     ConsultationStatus @default(PENDING)
  adminNotes String?            @db.Text
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedItem {
  id         String   @id @default(cuid())
  userId     String
  showcaseId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showcase Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  @@unique([userId, showcaseId])
}

model SiteSettings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   @db.Text
  updatedAt       DateTime @updatedAt
}

model OtpToken {
  id         String   @id @default(cuid())
  identifier String   // email atau phone (E.164 tanpa +)
  token      String
  type       String   @default("password_reset") // password_reset | password_change | phone_register | phone_verify
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, type])
}

enum Role {
  USER
  ADMIN
}

enum PersonaStyle {
  SANTAI
  FORMAL
  CERIA
  PROFESIONAL
  CUSTOM
}

enum EducationType {
  YOUTUBE
  TIKTOK
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  DORMANT
}

enum CapabilityChannel {
  WHATSAPP
  INSTAGRAM_DM
  TELEGRAM
  EMAIL
  DISCORD
  INSTAGRAM_POST
  FACEBOOK_POST
  LINKEDIN_POST
  THREADS_POST
  TWITTER_POST
  TIKTOK_POST
  PINTEREST_POST
  BOOKING_CALENDAR
  IMAGE_GEN
  VIDEO_SCRIPT
  DAILY_NEWS_BRIEFING
  WEBHOOK_INTEGRATION
  WHITE_LABEL
}

enum ConnectionStatus {
  REQUESTED
  CONTACTED
  ACTIVE
  REVOKED
  REJECTED
}

model RegisteredIp {
  id          String   @id @default(cuid())
  ip          String   @unique
  userId      String?  // first user that registered with this IP
  isWhitelist Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id            String              @id @default(cuid())
  userId        String              @unique
  packageId     String
  status        SubscriptionStatus  @default(TRIAL)
  startsAt      DateTime            @default(now())
  endsAt        DateTime?
  trialEndsAt   DateTime?
  cancelledAt   DateTime?
  // Credit accounting (LOCKED v1.0 2026-05-23 - real cost AI, 1 kredit = $0.001)
  creditsTotal  Int                 @default(0)  // quota per cycle
  creditsUsed   Int                 @default(0)
  creditsResetAt DateTime?          // next refresh tick
  cycleStartAt  DateTime?           // current cycle start (for analytics)
  lastRefreshAt DateTime?           // last successful refresh tick
  // Billing
  paymentMethod String?             // "midtrans" | "manual" | "trial"
  externalRef   String?             // Midtrans order id, etc.
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@index([status])
  @@index([packageId])
  @@index([creditsResetAt])
}

model UserCapability {
  id         String            @id @default(cuid())
  userId     String
  channel    CapabilityChannel
  enabled    Boolean           @default(false)
  // Capability is granted by plan AND requires admin toggle on
  grantedByPlan Boolean        @default(false)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([channel])
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  channel   String   // free-form (whatsapp_send, image_gen, post_ig, etc.)
  credits   Int      @default(1)
  taskType  String?  // task_type label (e.g. "wa_reply", "image_gen", "caption_gen")
  costUsd   Float?   // real AI cost in USD (from 9Router usageHistory)
  tokensIn  Int?     // prompt tokens
  tokensOut Int?     // completion tokens
  model     String?  // model id used (e.g. "claude-sonnet-4-6")
  meta      String?  @db.Text // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([channel])
  @@index([taskType])
}

model ConnectionRequest {
  id          String           @id @default(cuid())
  userId      String
  channel     CapabilityChannel
  status      ConnectionStatus @default(REQUESTED)
  // Form-fed details (e.g. user's IG handle, phone, account name)
  handle      String?
  notes       String?          @db.Text
  adminNotes  String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}
